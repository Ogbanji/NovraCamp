rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // =====================================================
    // USERS COLLECTION
    // =====================================================
    match /users/{userId} {
      // Anyone can read user profiles
      allow read: if true;
      
      // Users can create their own profile
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Users can update their own profile
      allow update: if isAuthenticated() && isOwner(userId);
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // =====================================================
    // ADMINS COLLECTION
    // =====================================================
    match /admins/{adminId} {
      // Only admins can read admin list
      allow read: if isAdmin();
      
      // Only existing admins can create new admins
      allow create: if isAdmin();
      
      // Only admins can update admin records
      allow update: if isAdmin();
      
      // Only admins can delete admin records
      allow delete: if isAdmin();
    }
    
    // =====================================================
    // TASKS COLLECTION
    // =====================================================
    match /tasks/{taskId} {
      // Anyone can read tasks
      allow read: if true;
      
      // Only admins can create tasks
      allow create: if isAdmin();
      
      // Only admins can update tasks
      allow update: if isAdmin();
      
      // Only admins can delete tasks
      allow delete: if isAdmin();
    }
    
    // =====================================================
    // TASK SUBMISSIONS COLLECTION
    // =====================================================
    match /taskSubmissions/{submissionId} {
      // Users can read their own submissions, admins can read all
      allow read: if isAuthenticated() && 
                     (isOwner(resource.data.userId) || isAdmin());
      
      // Authenticated users can create submissions
      allow create: if isAuthenticated() && 
                       isOwner(request.resource.data.userId);
      
      // Only admins can update submissions (for approval/rejection)
      allow update: if isAdmin();
      
      // Only admins can delete submissions
      allow delete: if isAdmin();
    }
    
    // =====================================================
    // CRYPTO NEWS COLLECTION
    // =====================================================
    match /crypto_news/{newsId} {
      // Anyone can read crypto news
      allow read: if true;
      
      // Only server/admin can write crypto news
      allow write: if isAdmin();
    }
    
    // =====================================================
    // X AUTH STATES COLLECTION (for OAuth flow)
    // =====================================================
    match /x_auth_states/{stateId} {
      // Only server can read/write auth states
      allow read, write: if false; // Service account only
    }
    
    // =====================================================
    // X CONNECTIONS COLLECTION (for uniqueness constraint)
    // =====================================================
    match /x_connections/{xId} {
      // Users can read their own connection
      allow read: if isAuthenticated() && isOwner(resource.data.uid);
      
      // Only server can write connections
      allow write: if false; // Service account only
    }
    
    // =====================================================
    // CAMPAIGNS COLLECTION (if exists)
    // =====================================================
    match /campaigns/{campaignId} {
      // Anyone can read campaigns
      allow read: if true;
      
      // Only admins can manage campaigns
      allow write: if isAdmin();
    }
    
    // =====================================================
    // ANALYTICS COLLECTION (if exists)
    // =====================================================
    match /analytics/{docId} {
      // Only admins can read analytics
      allow read: if isAdmin();
      
      // Only server can write analytics
      allow write: if false; // Service account only
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
